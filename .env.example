# Required: create a Telegram bot and discover your numeric ID using the setup guide.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
# Optional: a shared group chat (e.g. with your partner). See docs/SETUP.md section 10.
TELEGRAM_GROUP_ID=

# For Railway use /data/foodbot.sqlite3 and attach a volume at /data.
DATABASE_PATH=data/foodbot.sqlite3
TIMEZONE=America/Los_Angeles
CHECKIN_DAY=monday
CHECKIN_TIME=10:00
QUIET_START=21
QUIET_END=9
MAX_FOLLOWUPS=2

# Optional. All button flows work without AI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
